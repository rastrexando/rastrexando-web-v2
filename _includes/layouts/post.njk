---
layout: base
title: Evento — Rastrexando
---

{% set catalogLocation = locations[location] or {} %}
{% set eventMapLat = map_lat or catalogLocation.lat %}
{% set eventMapLng = map_lng or catalogLocation.lng %}
{% set eventProvince = province or catalogLocation.province %}
{% set eventOrganizations = organizers | resolveOrganizations(organizations) %}

<nav class="breadcrumbs">
  <ul>
    <li>{% renderHTMXLink "/", "Inicio", "link" %}</li>
    <li class="breadcrumb-sep">›</li>
    <li>{% renderHTMXLink "/calendarios/" + date.getFullYear() + "/", date.getFullYear(), "link" %}</li>
    <li class="breadcrumb-sep">›</li>
    <li class="is-light-blue">{{ date | toGLMonthDay }}</li>
  </ul>
</nav>

<div class="event-detail-layout{% if not image %} event-detail-layout--no-image{% endif %}">
{% if image %}
  <a class="event-hero-link" href="/recursos/imaxes/{{ image }}" title="{{ title }}" target="_blank" rel="noopener noreferrer">
    <img class="event-hero" src="/recursos/imaxes/{{ image }}" alt="{{ title }}" />
    <span class="hero-expand-hint"><i class="fi-arrows-expand"></i> Ampliar imaxe</span>
  </a>
{% endif %}

<div class="page page-post">

  {% set relDate = date | toRelativeDate %}
  <header class="event-primary-header">
    <h1>{{ title }}</h1>
  </header>

  <div class="event-type-row">
    {% if tags %}
      {% if "andaina" in tags %}
        <span class="type-pill andaina">Andaina</span>
      {% elif "orientacion" in tags %}
        <span class="type-pill orientacion">Orientación</span>
      {% else %}
        <span class="type-pill rastrexo">Rastrexo</span>
      {% endif %}
    {% endif %}
    {% if relDate %}
      <span class="relative-date event-date-relative" data-date="{{ date.toISOString() }}">{{ relDate }}</span>
    {% endif %}
  </div>

  <div class="event-info event-date-info">
    <div class="event-info-item">
      <i class="fi-calendar is-light-blue"></i>
      <time datetime="{{ date | toISODate }}">{{ date | toGlLocale }}</time>
    </div>
    {% if not (eventMapLat and eventMapLng) %}
      <div class="event-info-item">
        <i class="fi-marker is-light-blue"></i>
        <span>{{ location }}</span>
      </div>
    {% endif %}
  </div>

  {% if content | trim %}
    <div class="event-description">
      {{ content | safe }}
    </div>
  {% endif %}

  {% if notices %}
    <div class="event-notices" aria-label="Avisos do evento">
      {% for notice in notices %}
        {% renderNotice notice.date, notice.message %}
      {% endfor %}
    </div>
  {% endif %}

  {% if eventOrganizations.length > 0 %}
    <section class="event-organizations" aria-labelledby="event-organizations-title">
      <h2 id="event-organizations-title"><i class="fi-torsos-all is-light-blue"></i> Organiza</h2>
      <div class="event-organization-list">
        {% for organization in eventOrganizations %}
          {% set organizationUrl = organization | organizationPrimaryUrl %}
          {% set organizationEvents = collections.post | eventsForOrganization(organization.slug) %}
          {% set relatedEvents = collections.post | relatedOrganizationEvents(organization.slug, page.url) %}
          <article class="event-organization-card">
            <header class="event-organization-header">
              {% if organization.logo %}
                <img class="organization-avatar" src="/recursos/imaxes/{{ organization.logo }}" alt="" loading="lazy" />
              {% else %}
                <span class="organization-avatar" aria-hidden="true">{{ organization.name | first }}</span>
              {% endif %}
              <div>
                <h3>{{ organization.name }}</h3>
                {% if organizationUrl %}
                  <a class="event-organization-external" href="{{ organizationUrl }}" target="_blank" rel="noopener noreferrer">
                    {% if organization.links.website %}<i class="fi-web"></i> Páxina web{% elif organization.links.instagram %}<i class="fi-social-instagram"></i> Instagram{% else %}<i class="fi-social-facebook"></i> Facebook{% endif %}
                    <span class="show-for-sr"> de {{ organization.name }}</span>
                  </a>
                {% endif %}
              </div>
            </header>

            {% if relatedEvents.length > 0 %}
              <div class="event-organization-related">
                <h4>Outros eventos</h4>
                <ul>
                  {% for relatedEvent in relatedEvents %}
                    <li>
                      <a
                        href="{{ relatedEvent.url }}"
                        hx-get="{{ relatedEvent.url }}"
                        hx-target="#main-container"
                        hx-select="#main-container"
                        hx-swap="outerHTML"
                        hx-push-url="true"
                      >
                        <span title="{{ relatedEvent.data.title }}">{{ relatedEvent.data.title }}</span>
                        <time datetime="{{ relatedEvent.data.date | toISODate }}">{{ relatedEvent.data.date | toNumericDate }}</time>
                      </a>
                    </li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <a
              class="event-organization-all"
              href="/organizacions/{{ organization.slug }}/"
              hx-get="/organizacions/{{ organization.slug }}/"
              hx-target="#main-container"
              hx-select="#main-container"
              hx-swap="outerHTML"
              hx-push-url="true"
            >Ver todos os eventos ({{ organizationEvents.length }}) <span aria-hidden="true">→</span></a>
          </article>
        {% endfor %}
      </div>
      {% if source_url %}
        <a class="event-source-link" href="{{ source_url }}" target="_blank" rel="noopener noreferrer"><i class="fi-link"></i> Ver a publicación orixinal</a>
      {% endif %}
    </section>
  {% elif source_name or source_url %}
    <section class="event-organizations event-organizations--legacy" aria-labelledby="event-organizations-title">
      <h2 id="event-organizations-title"><i class="fi-torsos-all is-light-blue"></i> Organiza</h2>
      <div class="event-info">
        <div class="event-info-item">
          {% if source_url and "instagram.com" in source_url %}
            <i class="fi-social-instagram is-light-blue"></i>
          {% else %}
            <i class="fi-social-facebook is-light-blue"></i>
          {% endif %}
          {% if source_url %}<a href="{{ source_url }}" title="{{ source_name }}" target="_blank" rel="noopener noreferrer">{{ source_name or "Máis información" }}</a>{% else %}<span>{{ source_name }}</span>{% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if videos %}
    <section class="video-section">
      <h2>Vídeos</h2>
      <div class="video-list">
        {% for video in videos %}
          <iframe width="100%" height="315" src="https://www.youtube.com/embed/{{ video.id }}" title="{{ video.title }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if eventMapLat and eventMapLng %}
    <section class="event-map" aria-labelledby="event-map-title">
      <div class="event-map-heading">
        <h2 id="event-map-title"><i class="fi-marker is-light-blue"></i> {{ location }}</h2>
      </div>
      <div
        class="event-map-frame event-map-leaflet"
        data-event-map
        data-lat="{{ eventMapLat }}"
        data-lng="{{ eventMapLng }}"
        data-location="{{ location }}"
        role="region"
        aria-label="Localización aproximada de {{ location }}"
      ></div>
      <noscript>
        <p><a href="{{ eventMapLat | mapLinkUrl(eventMapLng) }}">Ver a localización aproximada en OpenStreetMap</a></p>
      </noscript>
      <p class="event-map-notice"><strong>Localización aproximada.</strong> Consulta a organización para o punto de saída.</p>
    </section>
  {% endif %}

  <div class="share-row">
    <span class="share-label">Compartir:</span>
    <a class="share-btn share-whatsapp" href="https://wa.me/?text=https://rastrexando.eu{{ page.url }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <a class="share-btn share-facebook" href="https://www.facebook.com/sharer/sharer.php?u=https://rastrexando.eu{{ page.url }}" target="_blank" rel="noopener noreferrer"><i class="fi-social-facebook"></i> Facebook</a>
  </div>

  <div class="prev-next-buttons">
    {% set previousPost = collections.post | getPreviousCollectionItem(page) %}
    {% set nextPost = collections.post | getNextCollectionItem(page) %}
    {% if previousPost %}
      {% renderHTMXLink previousPost.url, "← Anterior" %}
    {% else %}
      <div class='not-allowed'>← Anterior</div>
    {% endif %}
    {% if nextPost %}
      {% renderHTMXLink nextPost.url, "Seguinte →" %}
    {% else %}
      <div class='not-allowed'>Seguinte →</div>
    {% endif %}
  </div>

</div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "{{ title }}",
  "url": "https://rastrexando.eu{{ page.url }}",
  "startDate": "{{ date | toISODate }}",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "{{ location }}"{% if eventMapLat and eventMapLng %},
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ eventMapLat }},
      "longitude": {{ eventMapLng }}
    }{% endif %}{% if eventProvince %},
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "{{ eventProvince }}",
      "addressCountry": "ES"
    }{% endif %}
  }{% if image %},
  "image": "https://rastrexando.eu/recursos/imaxes/{{ image }}"{% endif %}{% if eventOrganizations.length > 0 %},
  "organizer": [
    {% for organization in eventOrganizations %}{
      "@type": "Organization",
      "name": "{{ organization.name }}",
      "url": "https://rastrexando.eu/organizacions/{{ organization.slug }}/"{% set organizationUrl = organization | organizationPrimaryUrl %}{% if organizationUrl %},
      "sameAs": "{{ organizationUrl }}"{% endif %}
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]{% elif source_name %},
  "organizer": {
    "@type": "Organization",
    "name": "{{ source_name }}"{% if source_url %},
    "url": "{{ source_url }}"{% endif %}
  }{% endif %}
}
</script>
