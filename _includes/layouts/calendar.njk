---
layout: base
title: Calendario - Rastrexando
---

<nav class="breadcrumbs">
  <ul>
    <li>{% renderHTMXLink "/", "Inicio", "link" %}</li>
    <li class="breadcrumb-sep">›</li>
    <li class="is-light-blue">{{ year.name }}</li>
  </ul>
</nav>

{% set yearCover = collections.yearCovers | findYearCover(year.name) %}
{% renderYearHero yearCover %}

<div class="page page-calendar">
  {% renderPrevNextButtons pagination, year.name %}

  {% set monthGroups = collections[year.name] | groupEventsByMonth %}

  {% if monthGroups.length > 1 %}
    <nav class="month-index" aria-label="Meses con eventos">
      {% for month in monthGroups %}
        <a href="#{{ month.id }}"{% if month.isCurrent %} aria-current="date"{% endif %}>{{ month.name }}</a>
      {% endfor %}
    </nav>
  {% endif %}

  <div class="calendar-months">
    {% for month in monthGroups %}
      <section class="calendar-month{% if month.isCurrent %} calendar-month--current{% endif %}" id="{{ month.id }}">
        <header class="month-heading">
          <h2>{{ month.name }}</h2>
          <span>{{ month.events.length }} {% if month.events.length == 1 %}evento{% else %}eventos{% endif %}</span>
        </header>
        {% for post in month.events %}
          {% renderPost post %}
        {% endfor %}
      </section>
    {% endfor %}
  </div>
</div>
