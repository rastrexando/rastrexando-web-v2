---
title: Rastrexando
layout: skeleton
---

<div id="layout-base" hx-indicator="#global-htmx-indicator">
  <div
    id="global-htmx-indicator"
    class="htmx-indicator global-htmx-indicator"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <span class="global-htmx-indicator-glow" aria-hidden="true"></span>
    <img src="/recursos/rastrexando-simbolo.png" alt="" width="64" height="64" />
    <span class="visually-hidden">Cargando contido…</span>
  </div>
  <div class="site-header-shell">
      <span class="star-glints" aria-hidden="true"></span>
      <header id="main-header" class="wrapper">
        <a
          id="rastrexando-logo"
          href="/"
          hx-get="/"
          hx-target="#main-container"
          hx-select="#main-container"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          <img class="image" src="/recursos/rastrexando-circular.png" alt="Curuxa e lúa de Rastrexando" />
          <span class="brand-copy">
            <span class="title">Rastrexando</span>
            <span class="tagline">Rastrexos e andainas</span>
          </span>
        </a>
        {% set currentYear = collections.yearCovers | last %}
        <nav class="header-nav" aria-label="Navegación principal">
          <a
            href="/"
            hx-get="/"
            hx-target="#main-container"
            hx-select="#main-container"
            hx-swap="outerHTML"
            hx-push-url="true"
            {% if page.url == "/" %}aria-current="page"{% endif %}
          ><i class="fi-home"></i> Inicio</a>
          <a
            href="{{ currentYear.url }}"
            hx-get="{{ currentYear.url }}"
            hx-target="#main-container"
            hx-select="#main-container"
            hx-swap="outerHTML"
            hx-push-url="true"
            {% if "/calendarios/" in page.url %}aria-current="page"{% endif %}
          ><i class="fi-calendar"></i> Calendario</a>
          <a
            href="/axuda/"
            hx-get="/axuda/"
            hx-target="#main-container"
            hx-select="#main-container"
            hx-swap="outerHTML"
            hx-push-url="true"
            {% if page.url == "/axuda/" %}aria-current="page"{% endif %}
          ><i class="fi-info"></i> Axuda</a>
        </nav>
      </header>
  </div>
  <main id="main-container">
    <div class="page-center-content">
      <div class="page-content">
        {{ content | safe }}
      </div>
    </div>
  </main>
  <footer id="main-footer">
    <div class="wrapper">
      <div class="footer-brand">
        <a
          class="footer-brand-link"
          href="/"
          hx-get="/"
          hx-target="#main-container"
          hx-select="#main-container"
          hx-swap="outerHTML"
          hx-push-url="true"
        >
          <img class="footer-symbol" src="/recursos/rastrexando-contratipo.png" alt="" loading="lazy" decoding="async" />
          <span>Rastrexando</span>
        </a>
        <span class="footer-copy">Rastrexos e andainas en Galicia · 2017–{{ currentYear.year }}</span>
      </div>
      <nav class="footer-nav" aria-label="Navegación secundaria">
        <a
          href="{{ currentYear.url }}"
          hx-get="{{ currentYear.url }}"
          hx-target="#main-container"
          hx-select="#main-container"
          hx-swap="outerHTML"
          hx-push-url="true"
        ><i class="fi-calendar"></i> Calendario</a>
        <a
          href="/axuda/"
          hx-get="/axuda/"
          hx-target="#main-container"
          hx-select="#main-container"
          hx-swap="outerHTML"
          hx-push-url="true"
        ><i class="fi-info"></i> Axuda</a>
        <a href="https://www.facebook.com/rastrexando" target="_blank" rel="noopener noreferrer">
          <i class="fi-social-facebook"></i> Facebook
        </a>
        <a href="mailto:carlos@rastrexando.eu">
          <i class="fi-mail"></i> Contacto
        </a>
      </nav>
    </div>
  </footer>
</div>
