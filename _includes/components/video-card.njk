{% set videoOrganizations = video.organizerSlugs | resolveOrganizations(organizations) %}
<article
  class="current-video-card"
  {% if filterableVideoCards %}
    data-video-card
    data-video-channel="{{ video.channel }}"
    data-video-year="{{ video.eventYear }}"
    data-video-organizations="{{ video.organizerSlugs | join(',') }}"
  {% endif %}
>
  <a
    class="current-video-media"
    href="https://www.youtube.com/watch?v={{ video.id }}"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Reproducir {{ video.title }} en YouTube"
  >
    <img
      src="https://i.ytimg.com/vi/{{ video.id }}/hqdefault.jpg"
      alt=""
      loading="lazy"
      width="480"
      height="360"
    />
    <span class="current-video-play" aria-hidden="true"><i class="fi-play"></i></span>
  </a>
  <div class="current-video-body">
    <p class="current-video-meta">
      <a href="/videos/?canal={{ video.channel | urlEncode }}">Canal: {{ video.channel }}</a>
      {% if video.publishedDate %}
        <span aria-hidden="true">·</span>
        <time datetime="{{ video.publishedDate | toISODate }}">{{ video.publishedDate | toNumericDate }}</time>
      {% endif %}
    </p>
    <h3><a
      class="current-video-title-link"
      href="{{ video.eventUrl }}"
      hx-get="{{ video.eventUrl }}"
      hx-target="#main-container"
      hx-select="#main-container"
      hx-swap="outerHTML"
      hx-push-url="true"
    >{{ video.title }}</a></h3>
    {% if videoOrganizations.length > 0 %}
      <p class="current-video-organizations">
        {% for organization in videoOrganizations %}<a
          href="/organizacions/{{ organization.slug }}/"
          hx-get="/organizacions/{{ organization.slug }}/"
          hx-target="#main-container"
          hx-select="#main-container"
          hx-swap="outerHTML"
          hx-push-url="true"
        >{{ organization.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
      </p>
    {% endif %}
  </div>
</article>
