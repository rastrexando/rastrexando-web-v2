---
layout: base
title: Inicio - Rastrexando
eleventyImport:
  data ["years"]
pagination:
  data: collections.featured
  size: 10
  reverse: true
  alias: posts
---


<div class="page page-index">
  <header class="home-section-header">
    <div>
      <h1><i class="fi-star is-light-blue"></i> Destacados</h1>
      <p>Unha selección de rastrexos e andainas</p>
    </div>
  </header>
  <section class="featured-section" aria-label="Eventos destacados">
    {% if pagination.items.length > 0 %}
    <div class="featured-grid">
      {% for post in pagination.items %}
        {% renderPost post, organizations %}
      {% endfor %}
    </div>

    {% if pagination.pages.length > 1 %}
      <ul class="pagination">
        <li>Máis:</li>
        {%- for pageEntry in pagination.pages %}
          {% if page.url == pagination.hrefs[loop.index0] %}
            <li>{{ loop.index }}</li>
          {% else %}
            <li>
              <a href="{{ pagination.hrefs[ loop.index0 ] }}" {% if page.url == pagination.hrefs[ loop.index0 ] %} aria-current="page" {% endif %}>{{ loop.index }}</a>
            </li>
          {% endif %}
        {%- endfor %}
      </ul>
    {% endif %}
    {% else %}
      <p class="empty-featured">Agora mesmo non hai eventos destacados. Consulta o calendario para ver todos os publicados.</p>
    {% endif %}
  </section>

  <div class="section-divider"></div>

  {% set activeYear = collections.yearCovers | last %}
  <section class="active-calendar-section" aria-labelledby="active-calendar-title">
    <header class="home-section-header home-section-header--action">
      <div>
        <h2 id="active-calendar-title">Calendario {{ activeYear.year }}</h2>
        <p>Consulta todos os eventos publicados deste ano</p>
      </div>
      <a
        href="{{ activeYear.url }}"
        hx-get="{{ activeYear.url }}"
        hx-target="#main-container"
        hx-select="#main-container"
        hx-swap="outerHTML"
        hx-push-url="true"
      >Ver calendario <span aria-hidden="true">→</span></a>
    </header>

    {% renderActiveYearCard activeYear %}
    {% renderCalendarMap collections[activeYear.year], locations, activeYear.year %}
  </section>

  {% if collections.currentYearVideos.length > 0 %}
  <section class="current-videos-section" aria-labelledby="current-videos-title">
    <header class="home-section-header home-section-header--action">
      <div>
        <h2 id="current-videos-title"><i class="fi-play-video is-light-blue"></i> Últimos vídeos</h2>
        <p>Unha ollada aos rastrexos e andainas máis recentes</p>
      </div>
      <a
        href="/videos/"
        hx-get="/videos/"
        hx-target="#main-container"
        hx-select="#main-container"
        hx-swap="outerHTML"
        hx-push-url="true"
      >Ver todos <span aria-hidden="true">→</span></a>
    </header>
    <div class="current-videos-grid">
      {% for video in collections.currentYearVideos %}
        {% include "components/video-card.njk" %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="year-covers-section">
    <header class="home-section-header">
      <div>
        <h2>Arquivo</h2>
        <p>Explora os calendarios de anos anteriores</p>
      </div>
    </header>
    <div class="year-covers-grid">
      {% for item in collections.yearCovers | reverse %}
      {% if item.year != activeYear.year %}
      {% renderYearCoverItem item %}
      {% endif %}
      {% endfor %}
    </div>
  </section>

  <aside class="home-help-card">
    <div>
      <strong>Que é un rastrexo?</strong>
      <span>Descubre como funcionan e que necesitas para participar.</span>
    </div>
    {% renderHTMXLink "/axuda/", "Consulta a guía →" %}
  </aside>

</div>
